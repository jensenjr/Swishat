# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional
PORT=5000

# SMS via 46elks — used for PIN recovery by SMS.
# Get credentials at https://46elks.com (dashboard → Account → API Credentials).
# Leave blank to disable SMS features.
# NEVER commit real values here. In production set them in Coolify's
# environment-variable settings (or a local, git-ignored .env for dev).
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Sender shown to recipients: an alphanumeric name — max 11 chars, ASCII
# letters/digits only (no spaces, hyphens, or å/ä/ö), e.g. Swishat — or one of
# your 46elks virtual numbers. Leave blank to use the default "Swishat".
ELKS_FROM=

# Per-number SMS abuse caps (optional — sensible defaults shown). These are
# IP-independent so a number can't be SMS-bombed even from rotating IPs.
SMS_RESEND_COOLDOWN_SEC=60
SMS_MAX_PER_HOUR=3
SMS_MAX_PER_DAY=10

# Cover-image storage. STORAGE_DRIVER=local (default) | s3
STORAGE_DRIVER=local

# --- local driver ---
# Directory images are written to. In production point this at a Coolify
# persistent volume so images survive redeploys (e.g. /app/uploads).
UPLOAD_DIR=./uploads

# --- s3 driver (AWS S3 / Cloudflare R2 / MinIO) — only needed if STORAGE_DRIVER=s3 ---
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=swishat-covers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL the images are served from (public bucket or CDN/custom domain).
# S3_PUBLIC_BASE_URL=https://cdn.swishat.se
