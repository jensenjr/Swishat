# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional
PORT=5000

# SMS via 46elks — used for PIN recovery by SMS.
# Get credentials at https://46elks.com (dashboard → Account → API Credentials).
# Leave blank to disable SMS features.
# NEVER commit real values here. In production set them in Coolify's
# environment-variable settings (or a local, git-ignored .env for dev).
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Sender shown to recipients: an alphanumeric name — max 11 chars, ASCII
# letters/digits only (no spaces, hyphens, or å/ä/ö), e.g. Swishat — or one of
# your 46elks virtual numbers. Leave blank to use the default "Swishat".
ELKS_FROM=
